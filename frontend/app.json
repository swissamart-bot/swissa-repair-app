{
  "expo": {
    "name": "Swissa",
    "slug": "swissa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swissa",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of repair items",
        "NSPhotoLibraryUsageDescription": "Select item photos from gallery",
        "NSContactsUsageDescription": "Pick customer from contacts"
      },
      "bundleIdentifier": "com.emergent.offlinedbsync.jgwa5g"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.swissamartbot.swissa",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Pick customer details from contacts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select item photos from gallery",
          "cameraPermission": "Take photos of repair items"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
