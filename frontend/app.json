{
  "expo": {
    "name": "SWISSA REPAIR PRO",
    "slug": "swissa-repair-pro",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swissa-repair-pro",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of repair items",
        "NSPhotoLibraryUsageDescription": "Select item photos from gallery",
        "NSContactsUsageDescription": "Pick customer from contacts"
      },
      "bundleIdentifier": "com.swissamart.swissarepairpro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.swissamart.swissarepairpro",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Pick customer details from contacts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select item photos from gallery",
          "cameraPermission": "Take photos of repair items"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8f5b1af-7504-4d38-9b1d-19223e4d0708"
      }
    },
    "owner": "swissamart-bot"
  }
}
